rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permetti lettura e scrittura per le classi e impostazioni del docente
    match /classes/{classId} {
      allow read, write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
